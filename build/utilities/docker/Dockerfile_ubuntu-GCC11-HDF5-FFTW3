# Dockerfile for Ubuntu GCC11 env December 2023
FROM ubuntu

RUN \
apt-get update && \
apt-get install -y apt-utils build-essential git xsltproc

RUN \
apt-get install -y gcc libblas-dev liblapack-dev libopenmpi3 libhdf5-serial-dev libhdf5-mpi-dev libfftw3-dev

RUN \
apt-get -y install python2 libpython3-stdlib libpython3-dev python3-pip python3-venv

# General python packages required by test suite, excitingtools and Jupyter tutorials
RUN \
python3 -m pip install --upgrade --force pillow==7.0.0 wheel>=0.35.0 numpy>=1.14.5 matplotlib>=2.2.0   

# Test suite dependencies
RUN \
python3 -m pip install termcolor lxml pytest pyyaml
