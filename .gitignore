# .gitignore for exciting
#
# Please familiarise yourself with .gitignore patterns before contributing.
# Also consider whether it is better to add patterns to the root gitignore
# or if a local .gitignore is more appropriate.
#
# Basic patterns
# ----------------------------------------------------------
#   Entry                        Ignores
# ----------------------------------------------------------
#   target/      folder named target (due to the trailing /) recursively
#   target       file or folder named target recursively
#  /target       file or folder named target in the top-most directory (due to the leading /)
#  /target/      folder named target in the top-most directory (leading and trailing /)
#  *.class       every file or folder ending with .class recursively

# Exciting binaries 
# Found in the respective build folder
# Kept paths as 'exciting' is quite a general name 
/build*/
# Bin directory, covering all executables
/install/

# Binaries from standalone builds 
# Kept paths as 'species' and 'spacegroup' are very general names 
# TODO(Alex) Issue #45 Move standalone programs out of src - each should have its own .gitignore 
src/spacegroup/spacegroup
src/stateconvert/stateconvert
src/stateinfo/stateinfo
src/species/species
src/tools/atkp

# Compressed exciting binary
exciting.tar 
exciting.tar.gz

# System-specific files 
# RPM Specification File
*.spec    
# Debian 
*.deb
# Mac
.DS*
._.DS*

# Files auto-generated by the build process 
# Contains date and githash 
version.inc
# Auto-generated from the schema 
src/src_inputparser/inputmodules.f90
src/src_inputparser/speciesmodules.f90

# Documentation 
docs/exciting/

# Latex for at least spacegroup, stateconvert and stateinfo programs
# Covers any standalone programs lingering in src/
# See issue 45.
doc.tex

# Auto-generated Makefiles
Makefile.blas
Makefile.fft
Makefile.lapack
Makefile.libarpack
Makefile.libbzint
Makefile.libmsec
Makefile.mkmf
make.out
# Platform/compiler specific make file
build/make.inc

# Ignore build objects and certain temporary extensions
*.o
*.mod
*.a
*.f90_*
*.old
*.smod

# Leftover git merge files
*.diff
*.orig

# Text editor files
*.save
.*.sw*
*.un~
*~

# TeX files
*.aux
*.dvi
*.log
*.toc

# xml schema
xml/schema/wiki/
xml/sgroupinput.xsd
xml/excitinginput.xsd

# Compiled python scripts
*.pyc
# Python egg folders
*.egg-info/

# IDE folders
# VS Code files
/.vscode
# Jetbrains
.idea/  

# Ctags tag files
tags

