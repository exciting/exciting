<input>
        <title>C</title>
        <structure speciespath="./">
                <crystal scale="6.833">
                        <basevect>0.0 0.5 0.5 </basevect>
                        <basevect>0.5 0.0 0.5 </basevect>
                        <basevect>0.5 0.5 0.0 </basevect>
                </crystal>
 		<species speciesfile="B.xml" rmt="1.32">
	      		<atom coord="0.0000000000      0.0000000000      0.0000000000"/>
    		</species>
    		<species speciesfile="N.xml" rmt="1.28">
      			<atom coord="0.25 0.25 0.25"/>
    		</species>
        </structure>
        <groundstate
                ngridk="2 2 2"
                rgkmax="3.0"
                gmaxvr="10.0"
                epsengy="1e-5"
                vkloff="0.0 0.0 0.0"
                do="fromscratch"
                mixerswitch="1"
                mixer="msec"
                findlinentype="Wigner_Seitz"
                frozencore="false"
                outputlevel="high"
                nempty="4"
                useDensityMatrix="false"
                xctype="GGA_PBE">
        </groundstate>
        <xs
          xstype ="RT-TDDFT"
          ngridk="2 2 2"
          vkloff="0.01 -0.04 -0.07"
          nosym="true"
          reducek="false"
          nempty="10">
          <realTimeTDDFT
            propagator="EMR"
            timeStep="0.2d0"
            endTime="4.0d0"
            do="fromscratch"
            printTimingGeneral="false"
            printTimingDetailed="false"
            calculateNExcitedElectrons="true"
            calculateTotalEnergy="true"
            printAfterIterations="1"
            vectorPotentialSolver="midpoint"
            basis="unperturbedKS">
            <pmat readFromFile="false" forceHermitian="true" />
            <screenshots niter="20">
              <eigenvalues nEigenvalues="-1" tolerance="1d-14" />
              <projectionCoefficients printAbsoluteValue="true" format="F10.5" />
              <occupations format="F15.8" textFormat="true" binaryFormat="false" />
            </screenshots>
            <laser fieldType="total">
		          <sinSq t0="0.5d0" omega="1.d0" phase="0.d0" amplitude="1.0d0" pulseLength="5.d0"
			          direction="y"/>
            </laser>
          </realTimeTDDFT>

        </xs>
</input>
