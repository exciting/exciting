<input>
        <title>C</title>
        <structure speciespath="./">
                <crystal scale="6.7407">
                        <basevect>0.0 0.5 0.5 </basevect>
                        <basevect>0.5 0.0 0.5 </basevect>
                        <basevect>0.5 0.5 0.0 </basevect>
                </crystal>
                <species speciesfile="C.xml" rmt="1.4">
                        <atom coord="0.00 0.00 0.00"/>
                        <atom coord="0.25 0.25 0.25"/>
                </species>
        </structure>
        <groundstate
                ngridk="2 2 2"
                rgkmax="5.0"
                gmaxvr="12.0"
                epsengy="1e-6"
                reducek="false"
                nosym="true"
                vkloff="0.01 -0.03 0.05"
                do="fromscratch"
                mixerswitch="1"
                mixer="msec"
                findlinentype="Wigner_Seitz"
                frozencore="false"
                outputlevel="high"
                nempty="3"
                useDensityMatrix="false"
                radialgridtype="cubic-2"
                xctype="GGA_PBE">
        </groundstate>
        <xs
          xstype ="RT-TDDFT"
          ngridk="2 2 2"
	  vkloff="0.01 -0.03 0.05"
          nosym="true"
	  reducek="false"
          nempty="10">

          <realTimeTDDFT
            propagator="EHM"
            timeStep="0.25d0"
            endTime="4.0d0"
            printTimingGeneral="true"
            printTimingDetailed="true"
            calculateTotalEnergy="true"
            calculateNExcitedElectrons="true"
            printAfterIterations="1"
            vectorPotentialSolver="improvedeuler">
            <pmat readFromFile="false" writeToFile="false" forceHermitian="true" />
            <laser fieldType="total">
              <trapCos amplitude='1.d0' omega='8.d0' phase='0.d0' t0='0.0d0' riseTime='1.d0'
                      width='2.d0' direction='x'/>
            </laser>
            <screenshots niter="5">
              <eigenvalues nEigenvalues="-1" tolerance="1d-14" />
              <projectionCoefficients printAbsoluteValue="true" format="F10.5" />
            </screenshots>
            <predictorCorrector tol="1d-7" maxIterations="10" />
          </realTimeTDDFT>

        </xs>
</input>
