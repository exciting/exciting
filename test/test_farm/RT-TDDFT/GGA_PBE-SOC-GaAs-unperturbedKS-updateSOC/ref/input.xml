<?xml version="1.0"?>
<input>
  <title>GaAs</title>
  <structure speciespath=".">
    <crystal scale="10.673173">
      <basevect>0.0   0.5   0.5</basevect>
      <basevect>0.5   0.0   0.5</basevect>
      <basevect>0.5   0.5   0.0</basevect>
    </crystal>
    <species speciesfile="Ga.xml" rmt="2.0">
      <atom coord="0.00 0.00 0.00"/>
    </species>
    <species speciesfile="As.xml" rmt="2.2">
      <atom coord="0.25 0.25 0.25"/>
    </species>
  </structure>
  <groundstate 
      do="fromscratch" 
      ngridk="2 2 2" 
      outputlevel="high" 
      rgkmax="5.0" 
      gmaxvr="10.0" 
      xctype="GGA_PBE" 
      nempty="10" 
      maxscl="30" 
      epsengy="1.d-2"
      epschg="1.d-3"
      epspot="1.d-3"
      ValenceRelativity="zora" 
      useDensityMatrix="false">
      <spin spinorb="true" svlo="false" realspace="true"/>
  </groundstate>
  <xs
      xstype ="RT-TDDFT"
      ngridk="2 2 2"
      vkloff="0.01 0.02 0.03"
      nempty="10"
      nosym="true"
      reducek="false">
    <realTimeTDDFT
      propagator="SE"
      timeStep="0.1d0"
      endTime="3.d0"
      printTimingGeneral="true"
      printTimingDetailed="true"
      calculateTotalEnergy="true"
      calculateNExcitedElectrons="true"
      printAfterIterations="1"
      vectorPotentialSolver="improvedeuler"
      basis="unperturbedKS"
      saveState="true"
      do="fromscratch">
      <spinPropagation SOCGaugeCorrections="false" updateSOC="true"/>
      <laser fieldType="total">
        <trapCos amplitude='10.d0' omega='40.d0' phase='0.d0' t0='0.1d0' riseTime='0.5d0'
                 width='7.d0' direction='x'/>
      </laser>
      <screenshots niter="20">
        <eigenvalues nEigenvalues="-1" tolerance="1d-14" />
        <projectionCoefficients printAbsoluteValue="true" format="F10.5" />
        <occupations format="F15.8" textFormat="true" binaryFormat="false" />
      </screenshots>
      <pmat readFromFile="false" writeToFile="false" forceHermitian="true" />
    </realTimeTDDFT>
  </xs>

</input>
